---
import { type TocList } from '../types/common.ts'
type Props = Partial<{
  navList: TocList | undefined
  slug: string | undefined
  collection: string | undefined
  summary: string | undefined
}>
const { navList, summary } = Astro.props
---

{
  !!navList?.length && (
    <aside class='toc-wrapper wide'>
      <div class='toc'>
        <details>
          <summary>{summary || '目录'}</summary>
          <ul class='toc-link-wrapper'>
            {navList
              .map(navs =>
                navs.map((item, index) => (
                  <a
                    href={`#${item.slug}`}
                    class:list={[`toc-title-grade-${index + 1}`]}
                    data-link={item.slug}
                  >
                    {item.text}
                  </a>
                )),
              )
              .flat(1)}
          </ul>
        </details>
      </div>
    </aside>
  )
}

<style lang='scss'>
  aside.toc-wrapper.wide {
    position: absolute;
    height: calc(100% - var(--header-height) - var(--footer-height));
    left: calc(var(--gap) / 2);
    top: var(--header-height);
    left: 0;
    width: calc(var(--toc-width) - var(--gap));
    margin-left: 18px;

    .toc {
      position: sticky;
      top: var(--gap);
      border: unset;
      background: unset;
      border-radius: unset;
      width: 80%;
      margin: 0 2px 40px;

      details {
        max-width: var(--toc-width);
        max-height: calc(100vh - var(--header-height));
        border-radius: 8px;
        background-color: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(6px);
        border: 1px solid var(--border, #e5e7eb);
        transition: border-color 0.2s ease;

        &[open] {
          border-right: 1px solid var(--border, #e5e7eb);
          summary {
            border-bottom: 1px solid #aaa;
          }
        }

        summary {
          font-weight: 600;
          user-select: none;
          padding: 6px 10px;
          cursor: pointer;
          font-size: 15px;
          color: var(--text, #222);
        }

        .toc-link-wrapper {
          overscroll-behavior-y: contain;
          height: calc(100vh - var(--header-height) - var(--footer-height));
          max-width: var(--toc-width);
          overflow-y: auto;
          padding: 6px 8px 0;
          margin: 0;
          list-style: none;

          /* 滚动条美化 */
          &::-webkit-scrollbar {
            width: 4px;
          }
          &::-webkit-scrollbar-thumb {
            background-color: rgba(0, 0, 0, 0.15);
            border-radius: 4px;
          }
          &::-webkit-scrollbar-track {
            background: transparent;
          }

          a {
            display: block;
            font-size: 14px;
            line-height: 1.5;
            text-decoration: none;
            color: var(--text, #333);
            padding: 4px 8px;
            border-radius: 4px;
            transition:
              background-color 0.2s ease,
              color 0.2s ease;

            &:hover {
              background-color: var(--theme1-color4, rgba(112, 119, 161, 0.12));
              color: var(--active-text, #222);
            }

            &.active {
              background-color: #7077a1;
              color: #fff;
              font-weight: 500;
            }
          }

          $base-margin-left: 0.8em;
          @for $i from 1 through 6 {
            .toc-title-grade-#{$i} {
              padding-left: $i * $base-margin-left;
            }
          }
        }
      }
    }
  }

  /* 暗色模式兜底（如果你项目已有暗色变量可删除此段） */
  @media (prefers-color-scheme: dark) {
    aside.toc-wrapper.wide .toc details {
      background-color: rgba(30, 30, 30, 0.85);
      border-color: rgba(255, 255, 255, 0.12);

      summary {
        color: #e5e5e5;
      }

      .toc-link-wrapper a {
        color: #ccc;

        &:hover {
          background-color: rgba(112, 119, 161, 0.25);
          color: #fff;
        }

        &.active {
          background-color: #7077a1;
          color: #fff;
        }
      }
    }
  }
</style>

<!-- Toc.astro -->
<div class='toc-link-wrapper'>
  <!-- 这里一般是你根据 Astro.props.headings 渲染的 a[data-link] -->
  <slot />
</div>

<script is:inline type='module'>
  function initToc() {
    const tocLinkUL = document.querySelector('.toc-link-wrapper')
    const headings = document.querySelectorAll(
      'h1[id], h2[id], h3[id], h4[id], h5[id], h6[id]',
    )

    // 页面没有 TOC 或标题，直接退出
    if (!tocLinkUL || headings.length === 0) return

    const tocLinkMap = new Map()
    let currentActiveId = null
    let isClickScrolling = false
    const visibleHeadings = new Map()

    tocLinkUL.querySelectorAll('a[data-link]').forEach(a => {
      tocLinkMap.set(a.dataset.link, a)
    })

    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            visibleHeadings.set(entry.target.id, entry.target)
          } else {
            visibleHeadings.delete(entry.target.id)
          }
        })

        if (isClickScrolling) return

        let bestId = null
        let minTop = Infinity

        visibleHeadings.forEach((el, id) => {
          const top = el.getBoundingClientRect().top
          if (top >= 0 && top < window.innerHeight * 0.5 && top < minTop) {
            minTop = top
            bestId = id
          }
        })

        if (!bestId) {
          visibleHeadings.forEach((el, id) => {
            const top = el.getBoundingClientRect().top
            if (top < minTop) {
              minTop = top
              bestId = id
            }
          })
        }

        if (
          !bestId &&
          window.innerHeight + window.scrollY >= document.body.offsetHeight - 2
        ) {
          const last = headings[headings.length - 1]
          if (last) bestId = last.id
        }

        if (bestId && bestId !== currentActiveId) {
          currentActiveId = bestId
          tocLinkUL.querySelectorAll('a.active').forEach(link => {
            link.classList.remove('active')
          })

          const currentToc = tocLinkMap.get(currentActiveId)
          if (currentToc) {
            currentToc.classList.add('active')
            const containerHeight = tocLinkUL.clientHeight
            const currentTocTop = currentToc.offsetTop
            if (
              currentTocTop > containerHeight + tocLinkUL.scrollTop ||
              currentTocTop < tocLinkUL.scrollTop
            ) {
              tocLinkUL.scrollTop = currentTocTop - containerHeight / 2
            }
          }
        }

        if (window.scrollY === 0) {
          currentActiveId = null
          tocLinkUL?.querySelectorAll('a.active').forEach(link => {
            link.classList.remove('active')
          })
        }
      },
      {
        rootMargin: '0px 0px -70% 0px',
        threshold: 0,
      },
    )

    headings.forEach(h => observer.observe(h))

    // TOC 点击跳转 + 锁定 Observer
    const clickHandler = event => {
      const target = event.target
      if (!(target instanceof HTMLElement)) return

      isClickScrolling = true

      tocLinkUL.querySelectorAll('[data-link]').forEach(item => {
        item?.classList?.remove('active')
      })
      target.classList.add('active')

      const linkId = target.dataset.link
      if (linkId) currentActiveId = linkId

      setTimeout(() => {
        isClickScrolling = false
      }, 600)
    }

    tocLinkUL.addEventListener('click', clickHandler)

    // 挂在 window 上，方便 before-swap 清理
    window.__tocObserver = observer
    window.__tocClickHandler = clickHandler
  }

  // ✅ 每次首次加载 & 进入新 post 都会触发
  document.addEventListener('astro:page-load', initToc)

  // ✅ 页面切换前清理旧 Observer，防止观察已被销毁的 DOM
  document.addEventListener('astro:before-swap', () => {
    if (window.__tocObserver) {
      window.__tocObserver.disconnect()
      window.__tocObserver = null
    }
    if (window.__tocClickHandler) {
      document
        .querySelector('.toc-link-wrapper')
        ?.removeEventListener('click', window.__tocClickHandler)
      window.__tocClickHandler = null
    }
  })
</script>
